# Copy to .env — never commit real values
MODEL_PROVIDER=openrouter        # openrouter | google
MODEL_NAME=                      # e.g. <vendor>/<model> for openrouter
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
CORS_ORIGIN=http://localhost:5173
DATA_MODE=seed                   # seed | db (db = P2)
# Voice briefing (ElevenLabs text-to-speech). Without a key the Listen button is hidden.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb   # optional; a premade voice
ELEVENLABS_MODEL_ID=eleven_flash_v2_5      # optional
VOICE_RATE_LIMIT=10/minute
ELEVENLABS_AGENT_ID=                       # from scripts/voice_agent.py; enables Ask GridPulse
